<Window x:Class="PlatformerGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Platformer Game" 
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp"
        Background="Black">

    <Window.Resources>
        <!-- Level Select Button Style -->
        <Style x:Key="LevelBtn" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="28"/>
        </Style>

        <!-- Invisible Button Style for Level Select -->
        <Style x:Key="InvisibleBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Glow effect on hover -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#44FFD700"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- New Menu Button Style (Transparent with white border) -->
        <Style x:Key="MenuBtn" TargetType="Button">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#AA000000"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CCFFFFFF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ================= GAME LAYER ================= -->
        <Viewbox Stretch="Uniform" x:Name="GameViewbox">
            <Canvas x:Name="GameCanvas" Width="1920" Height="1080" Background="#222222">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="CameraTransform" />
                </Canvas.RenderTransform>
                <Image x:Name="PlayerVisual" Source="/Assets/PlayerStatic.png" Width="64" Height="128" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Canvas>
        </Viewbox>

        <!-- ================= MAIN MENU LAYER ================= -->
        <Grid x:Name="MainMenuUI" Background="Black">

            <!-- The Background Image -->
            <Image Source="pack://application:,,,/Assets/TitleScreen.png" Stretch="UniformToFill" />

            <!-- The Buttons (Positioned near the bottom) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,150">
                <Button Content="PLAY" Click="PlayButton_Click" Style="{StaticResource MenuBtn}"/>
                <Button Content="QUIT" Click="QuitButton_Click" Style="{StaticResource MenuBtn}"/>
            </StackPanel>
        </Grid>
        <!-- ================= LEVEL COMPLETE LAYER ================= -->
        <Grid x:Name="LevelCompleteUI" Background="#DD000000" Visibility="Hidden">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LevelCompleteText" Text="LEVEL COMPLETE!" Foreground="Gold" FontSize="72" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,50"/>

                <Button x:Name="NextLevelBtn" Content="Next Level" Click="NextLevelButton_Click" Width="300" Height="60" FontSize="24" Margin="0,10"/>
                <Button Content="Level Select" Click="LevelSelectButton_Click" Width="300" Height="60" FontSize="24" Margin="0,10"/>
            </StackPanel>
        </Grid>

        <!-- ================= LEVEL SELECT LAYER ================= -->
        <Grid x:Name="LevelSelectUI" Background="Black" Visibility="Hidden">

            <!-- Use a Viewbox so the buttons stay perfectly aligned with the image -->
            <Viewbox Stretch="UniformToFill">
                <!-- We use a 1000x666 canvas because the image is a 3:2 aspect ratio -->
                <Grid Width="1000" Height="666">

                    <!-- 1. The Background Image -->
                    <Image Source="/Assets/LevelSelectScreen.png" Stretch="Fill" />

                    <!-- 2. The Clickable Areas (Invisible Buttons) -->
                    <Canvas>
                        <!-- Row 1 -->
                        <Button Click="LevelButton_Click" Tag="0" Canvas.Left="285" Canvas.Top="255" Width="90" Height="90" Style="{StaticResource InvisibleBtnStyle}"/>
                        <Button Click="LevelButton_Click" Tag="1" Canvas.Left="400" Canvas.Top="255" Width="90" Height="90" Style="{StaticResource InvisibleBtnStyle}"/>
                        <Button Click="LevelButton_Click" Tag="2" Canvas.Left="515" Canvas.Top="255" Width="90" Height="90" Style="{StaticResource InvisibleBtnStyle}"/>
                        <Button Click="LevelButton_Click" Tag="3" Canvas.Left="630" Canvas.Top="255" Width="90" Height="90" Style="{StaticResource InvisibleBtnStyle}"/>

                        <!-- Row 2 -->
                        <Button Click="LevelButton_Click" Tag="4" Canvas.Left="285" Canvas.Top="360" Width="90" Height="90" Style="{StaticResource InvisibleBtnStyle}"/>
                        <Button Click="LevelButton_Click" Tag="5" Canvas.Left="400" Canvas.Top="360" Width="90" Height="90" Style="{StaticResource InvisibleBtnStyle}"/>
                        <Button Click="LevelButton_Click" Tag="6" Canvas.Left="515" Canvas.Top="360" Width="90" Height="90" Style="{StaticResource InvisibleBtnStyle}"/>
                        <Button Click="LevelButton_Click" Tag="7" Canvas.Left="630" Canvas.Top="360" Width="90" Height="90" Style="{StaticResource InvisibleBtnStyle}"/>

                        <!-- Row 3 -->
                        <Button Click="LevelButton_Click" Tag="8" Canvas.Left="285" Canvas.Top="465" Width="90" Height="90" Style="{StaticResource InvisibleBtnStyle}"/>
                        <Button Click="LevelButton_Click" Tag="9" Canvas.Left="400" Canvas.Top="465" Width="90" Height="90" Style="{StaticResource InvisibleBtnStyle}"/>
                        <Button Click="LevelButton_Click" Tag="10" Canvas.Left="515" Canvas.Top="465" Width="90" Height="90" Style="{StaticResource InvisibleBtnStyle}"/>
                        <Button Click="LevelButton_Click" Tag="11" Canvas.Left="630" Canvas.Top="465" Width="90" Height="90" Style="{StaticResource InvisibleBtnStyle}"/>
                    </Canvas>

                    <!-- Back Button (Bottom Right) -->
                    <Button Content="Back" Click="BackButton_Click" Width="120" Height="40" FontSize="20" Margin="0,0,40,40" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource MenuBtn}"/>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
    
</Window>