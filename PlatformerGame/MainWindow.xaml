<Window x:Class="PlatformerGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Platformer Game" Height="960" Width="540"
        WindowStyle="None" 
        WindowState="Maximized" 
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp"
        Background="Black">
    
    <!-- Viewbox scales the 1080x1920 canvas down to fit the window -->
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="GameCanvas" Width="1080" Height="1920" Background="#222222">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="CameraTransform" />
            </Canvas.RenderTransform>
            
            <!-- Player Visual -->
            <Rectangle x:Name="PlayerVisual" Width="64" Height="128" Fill="Red" />
            
        </Canvas>
    </Viewbox>
</Window>